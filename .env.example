# AstrixCore Verification AI - Environment Configuration

# Application
APP_NAME=AstrixCore Verification AI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_PREFIX=/api/v1

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./astrixcore.db
DATABASE_SYNC_URL=sqlite:///./astrixcore.db

# Redis (for Celery workers)
REDIS_URL=redis://localhost:6379/0

# File Storage
STORAGE_ROOT=./storage
RTL_STORAGE=./storage/rtl
TEST_STORAGE=./storage/tests
LOG_STORAGE=./storage/logs
COVERAGE_STORAGE=./storage/coverage

# LLM Configuration (leave empty to use local/offline mode)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Simulation
VERILATOR_PATH=verilator
ICARUS_PATH=iverilog
SIMULATION_TIMEOUT=300
MAX_CONCURRENT_SIMS=4

# AI Agent
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_RETRIES=3

# Security
ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]